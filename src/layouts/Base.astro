---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description: string;
  /** absolute or root-relative; defaults to the site card */
  image?: string;
  imageAlt?: string;
  /** "website" | "profile" | "article" */
  type?: string;
  lang?: string;
  /** JSON-LD, serialised into the head */
  schema?: Record<string, unknown>;
  publishedAt?: string;
}

const {
  title,
  description,
  image = "/og.png",
  imageAlt = "Hoijun Kim - software engineer",
  type = "website",
  lang = "en",
  schema,
  publishedAt,
} = Astro.props;

// Pages serves directories, so /blog answers with a 301 to /blog/. Keep the
// slash: the canonical, the sitemap and the links then all name the URL that
// actually returns 200.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageURL = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Hoijun Kim" href="/rss.xml" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta id="tc-light" name="theme-color" media="(prefers-color-scheme: light)" content="#FAF9F6" />
    <meta id="tc-dark" name="theme-color" media="(prefers-color-scheme: dark)" content="#12110F" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Hoijun Kim" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="preload" href="/fonts/plex-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plex-sans-600.woff2" as="font" type="font/woff2" crossorigin />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    {/* before first paint, so a stored choice never flashes the other theme */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // The two theme-color metas are keyed to the OS scheme, which a manual
      // choice overrides - repoint them, or the phone's address bar keeps the
      // colour of the theme the visitor just left.
      const root = document.documentElement;
      const mq = window.matchMedia("(prefers-color-scheme: dark)");
      const btn = document.getElementById("theme");
      const metas = {
        light: document.getElementById("tc-light") as HTMLMetaElement | null,
        dark: document.getElementById("tc-dark") as HTMLMetaElement | null,
      };
      const current = () => root.getAttribute("data-theme") || (mq.matches ? "dark" : "light");

      function apply() {
        const chosen = root.getAttribute("data-theme");
        if (metas.light && metas.dark) {
          metas.light.media = chosen ? (chosen === "light" ? "all" : "not all") : "(prefers-color-scheme: light)";
          metas.dark.media = chosen ? (chosen === "dark" ? "all" : "not all") : "(prefers-color-scheme: dark)";
        }
        btn?.setAttribute(
          "aria-label",
          current() === "dark" ? "Switch to light theme" : "Switch to dark theme",
        );
      }
      apply();
      mq.addEventListener("change", apply);
      btn?.addEventListener("click", () => {
        const next = current() === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        try { localStorage.setItem("theme", next); } catch (e) {}
        apply();
      });
    </script>
  </body>
</html>
