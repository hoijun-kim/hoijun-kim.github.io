---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// One format for every row - the language badge already carries that signal.
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" });

const schema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Hoijun Kim - writing",
  url: "https://hoijun-kim.github.io/blog",
  inLanguage: ["en", "ko"],
  blogPost: posts.map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    datePublished: p.data.date.toISOString(),
    url: `https://hoijun-kim.github.io/blog/${p.id}`,
  })),
};
---

<Base
  title="Writing - Hoijun Kim"
  description="Notes on building desktop developer tools in Go - what shape and fleet are made of, and what broke along the way."
  schema={schema}
>
  <section class="head wrap">
    <p class="label rise">Writing</p>
    <h1 class="rise">Notes from building the tools.</h1>
    <p class="lede rise">
      Mostly what went wrong and what it cost to fix. Some posts are in English, some in
      Korean - the language is marked on each.
      <a class="feed" href="/rss.xml"><Icon name="rss" size={13} /> RSS</a>
    </p>
  </section>

  <section class="list wrap">
    {posts.length === 0 ? (
      <p class="empty">Nothing published yet.</p>
    ) : (
      <ul>
        {posts.map((post) => (
          <li class="rise">
            <a href={`/blog/${post.id}`}>
              <div class="row-top">
                <h2 lang={post.data.lang}>{post.data.title}</h2>
                {post.data.lang !== "en" && <span class="lang">{post.data.lang}</span>}
                <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
              </div>
              <p lang={post.data.lang}>{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .head { padding-top: clamp(40px, 8vw, 84px); }
  h1 {
    margin: 14px 0 0; max-width: 18ch;
    font-size: clamp(1.9rem, 4vw, 2.7rem); font-weight: 600;
    line-height: 1.16; letter-spacing: -0.02em;
  }
  .lede { margin: 20px 0 0; max-width: 56ch; color: var(--ink-2); }
  .feed {
    display: inline-flex; align-items: center; gap: 5px; margin-left: 8px;
    font-family: var(--mono); font-size: 12px; color: var(--accent);
    vertical-align: 1px;
  }
  .feed:hover { text-decoration: underline; text-underline-offset: 3px; }

  .list { margin-top: clamp(40px, 7vw, 64px); }
  ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  li { border-bottom: 1px solid var(--line); }
  li a {
    display: block; padding: 24px 14px; margin-inline: -14px; border-radius: 10px;
    transition: background .15s;
  }
  li a:hover { background: var(--surface-2); }
  .row-top { display: flex; align-items: baseline; gap: 12px; }
  h2 { margin: 0; font-size: 1.32rem; font-weight: 600; letter-spacing: -0.014em; }
  li a:hover h2 { text-decoration: underline; text-underline-offset: 5px; }
  .lang {
    font-family: var(--mono); font-size: 10.5px; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--accent);
    border: 1px solid var(--accent); border-radius: 4px; padding: 0 5px;
  }
  time {
    margin-left: auto; font-family: var(--mono); font-size: 12px;
    color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  li p { margin: 9px 0 0; max-width: 62ch; color: var(--ink-2); font-size: 0.98rem; }
  .empty { font-family: var(--mono); font-size: 13px; color: var(--muted); }

  @media (max-width: 560px) {
    .row-top { flex-wrap: wrap; gap: 6px 10px; }
    time { margin-left: 0; width: 100%; }
  }
</style>
