---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import ViewCount from "../../components/ViewCount.astro";
import Comments from "../../components/Comments.astro";
import { viewsOn } from "../../config";
import { posts, partsOf, fmtLong, KIND_LABEL, type Post } from "../../lib/posts";
import { seriesOf } from "../../data/series";
import "../../styles/figure.css";

export async function getStaticPaths() {
  const all = await posts();
  return all.map((post) => ({ params: { slug: post.id }, props: { post, all } }));
}

type Props = { post: Post; all: Post[] };
const { post, all } = Astro.props;
const { Content, headings } = await render(post);

const run = post.data.series ? seriesOf(post.data.series.id) : undefined;
const parts = post.data.series ? partsOf(all, post.data.series.id) : [];
const here = parts.findIndex((p) => p.id === post.id);
const prev = here > 0 ? parts[here - 1] : undefined;
const next = here >= 0 && here < parts.length - 1 ? parts[here + 1] : undefined;

// The byline is site chrome, marked lang="en" like the rest of it, so the date
// is set in English on a Korean post too - the alternative is a Korean date
// string inside an element that claims to be English.
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  ...(post.data.updated && { dateModified: post.data.updated.toISOString() }),
  inLanguage: post.data.lang,
  author: { "@type": "Person", name: "Hoijun Kim", url: "https://hoijun-kim.github.io/" },
  mainEntityOfPage: `https://hoijun-kim.github.io/blog/${post.id}/`,
  image: `https://hoijun-kim.github.io/og/${post.id}.png`,
};
---

<Base
  title={`${post.data.title} - Hoijun Kim`}
  description={post.data.description}
  type="article"
  lang={post.data.lang}
  image={`/og/${post.id}.png`}
  imageAlt={post.data.title}
  publishedAt={post.data.date.toISOString()}
  schema={schema}
>
  <article class="post wrap">
    <header>
      <a class="back" href="/blog/" lang="en"><Icon name="arrow" size={13} /> writing</a>
      {run && (
        <a class="run" href={`/blog/series/${post.data.series!.id}/`}>
          <span class="run-name">{run.name}</span>
          <span class="run-part" lang="en">part {post.data.series!.part} of {parts.length}</span>
        </a>
      )}
      <h1>{post.data.title}</h1>
      <p class="meta" lang="en">
        <span class:list={["kind", post.data.kind]}>{KIND_LABEL[post.data.kind]}</span>
        <span class="sep">/</span>
        <time datetime={post.data.date.toISOString()}>{fmtLong(post.data.date)}</time>
        {post.data.updated && (
          <>
            <span class="sep">/</span>
            <span>updated {fmtLong(post.data.updated)}</span>
          </>
        )}
        {headings.length > 2 && (
          <>
            <span class="sep">/</span>
            <span>{headings.length} sections</span>
          </>
        )}
        <ViewCount path={`/blog/${post.id}/`} />
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {(prev || next) && (
      <nav class="run-nav" aria-label="Series navigation">
        {prev ? (
          <a class="step" href={`/blog/${prev.id}/`}>
            <span class="dir" lang="en">&larr; part {prev.data.series!.part}</span>
            <span class="ttl">{prev.data.title}</span>
          </a>
        ) : <span />}
        {next && (
          <a class="step next" href={`/blog/${next.id}/`}>
            <span class="dir" lang="en">part {next.data.series!.part} &rarr;</span>
            <span class="ttl">{next.data.title}</span>
          </a>
        )}
      </nav>
    )}

    <footer class="post-foot" lang="en">
      <a class="btn sm" href={run ? `/blog/series/${post.data.series!.id}/` : "/blog/"}>
        {run ? "All parts" : "More posts"}
      </a>
      <a class="btn sm" href="/rss.xml">RSS</a>
    </footer>

    <Comments />
  </article>

  {viewsOn && (
    <script>
      const el = document.querySelector<HTMLElement>(".views");
      if (el) {
        const { path, code } = el.dataset;
        fetch(`https://${code}.goatcounter.com/counter/${encodeURIComponent(path!)}.json`)
          .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
          .then((d: { count: string }) => {
            const n = Number(String(d.count).replace(/\D/g, ""));
            // one visit is this visit; a number that small says nothing
            if (!Number.isFinite(n) || n < 25) return;
            el.querySelector(".n")!.textContent = n.toLocaleString("en-GB");
            el.hidden = false;
          })
          .catch(() => {});
      }
    </script>
  )}
</Base>

<style>
  .post { max-width: 760px; padding-top: clamp(32px, 6vw, 64px); }
  .back {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--mono); font-size: 12px; color: var(--muted);
  }
  .back :global(svg) { transform: rotate(180deg); }
  .back:hover { color: var(--accent); }
  h1 {
    margin: 18px 0 0;
    font-size: clamp(1.9rem, 4.2vw, 2.6rem); font-weight: 600;
    line-height: 1.18; letter-spacing: -0.02em; text-wrap: balance;
  }
  .meta {
    margin: 14px 0 0; display: flex; flex-wrap: wrap; gap: 10px;
    font-family: var(--mono); font-size: 12px; color: var(--muted);
  }
  .meta .sep { opacity: 0.5; }
  .kind {
    font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase;
    border: 1px solid var(--line-strong); border-radius: 4px; padding: 1px 6px;
  }
  .kind.guide { color: var(--accent); border-color: var(--accent); }

  .run {
    display: inline-flex; align-items: baseline; gap: 10px; margin-top: 16px;
    padding: 4px 10px 4px 0;
  }
  .run-name { font-weight: 600; font-size: 0.95rem; color: var(--accent); }
  .run:hover .run-name { text-decoration: underline; text-underline-offset: 4px; }
  .run-part { font-family: var(--mono); font-size: 11.5px; color: var(--muted); }

  .run-nav {
    display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 56px;
  }
  .step {
    display: flex; flex-direction: column; gap: 6px; padding: 14px 16px;
    border: 1px solid var(--line); border-radius: 11px; background: var(--surface);
    transition: border-color .15s, background .15s;
  }
  .step:hover { border-color: var(--accent); background: var(--surface-2); }
  .step.next { text-align: right; }
  .dir { font-family: var(--mono); font-size: 11.5px; color: var(--accent); }
  .ttl { font-weight: 600; font-size: 0.98rem; }
  @media (max-width: 560px) {
    .run-nav { grid-template-columns: 1fr; }
    .step.next { text-align: left; }
  }
  .meta :global(.views) { font-variant-numeric: tabular-nums; }
  .meta :global(.views .sep) { opacity: 0.5; }

  .post-foot {
    display: flex; gap: 10px; margin-top: 56px;
    padding-top: 24px; border-top: 1px solid var(--line);
  }

  /* the article body */
  .prose { margin-top: 40px; font-size: 1.05rem; line-height: 1.72; color: var(--ink-2); }
  .prose :global(> * + *) { margin-top: 1.15em; }
  .prose :global(h2) {
    margin-top: 2.2em; font-size: 1.4rem; font-weight: 600; color: var(--ink);
    letter-spacing: -0.014em; line-height: 1.3;
  }
  .prose :global(h3) {
    margin-top: 1.8em; font-size: 1.12rem; font-weight: 600; color: var(--ink);
  }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .prose :global(a) {
    color: var(--accent); text-decoration: underline;
    text-underline-offset: 3px; text-decoration-thickness: 1px;
  }
  .prose :global(a:hover) { text-decoration-thickness: 2px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3em; }
  .prose :global(li + li) { margin-top: 0.4em; }
  .prose :global(li::marker) { color: var(--muted); }
  .prose :global(blockquote) {
    margin-inline: 0; padding: 2px 0 2px 20px;
    border-left: 3px solid var(--accent); color: var(--ink-2);
  }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 2.4em 0; }
  .prose :global(img) { border-radius: 10px; border: 1px solid var(--line); }
  .prose :global(figcaption) {
    font-family: var(--mono); font-size: 12px; color: var(--muted); margin-top: 8px;
  }
  .prose :global(table) {
    width: 100%; border-collapse: collapse; font-size: 0.95rem;
    display: block; overflow-x: auto;
  }
  .prose :global(th), .prose :global(td) {
    text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--line);
  }
  .prose :global(th) { color: var(--ink); font-weight: 600; }

  /* inline code and Shiki blocks */
  .prose :global(code) {
    font-family: var(--mono); font-size: 0.88em;
    background: var(--surface-2); border: 1px solid var(--line);
    border-radius: 5px; padding: 0.08em 0.32em;
  }
  .prose :global(pre) {
    padding: 16px 18px; border-radius: 11px; overflow-x: auto;
    border: 1px solid var(--line); font-size: 13px; line-height: 1.65;
  }
  .prose :global(pre code) {
    background: none; border: 0; padding: 0; font-size: inherit;
  }
  /* Shiki ships both themes. Take its token colours, but keep the block's
     background on the page's own surface - github-dark's blue-grey fights the
     warm paper this site is built on. */
  .prose :global(.astro-code) { background-color: var(--surface) !important; }
  :global(:root[data-theme="dark"]) .prose :global(.astro-code span) {
    color: var(--shiki-dark) !important;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .prose :global(.astro-code span) {
      color: var(--shiki-dark) !important;
    }
  }
</style>
