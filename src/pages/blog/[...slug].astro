---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { post: CollectionEntry<"blog"> };
const { post } = Astro.props;
const { Content, headings } = await render(post);

const fmt = (d: Date, lang: string) =>
  d.toLocaleDateString(lang === "ko" ? "ko-KR" : "en-GB", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  ...(post.data.updated && { dateModified: post.data.updated.toISOString() }),
  inLanguage: post.data.lang,
  author: { "@type": "Person", name: "Hoijun Kim", url: "https://hoijun-kim.github.io/" },
  mainEntityOfPage: `https://hoijun-kim.github.io/blog/${post.id}`,
  image: `https://hoijun-kim.github.io/og/${post.id}.png`,
};
---

<Base
  title={`${post.data.title} - Hoijun Kim`}
  description={post.data.description}
  type="article"
  lang={post.data.lang}
  image={`/og/${post.id}.png`}
  imageAlt={post.data.title}
  publishedAt={post.data.date.toISOString()}
  schema={schema}
>
  <article class="post wrap">
    <header>
      <a class="back" href="/blog"><Icon name="arrow" size={13} /> writing</a>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date, post.data.lang)}</time>
        {post.data.updated && (
          <>
            <span class="sep">/</span>
            <span>updated {fmt(post.data.updated, post.data.lang)}</span>
          </>
        )}
        {headings.length > 2 && (
          <>
            <span class="sep">/</span>
            <span>{headings.length} sections</span>
          </>
        )}
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-foot">
      <a class="btn sm" href="/blog">More posts</a>
      <a class="btn sm" href="/rss.xml">RSS</a>
    </footer>
  </article>
</Base>

<style>
  .post { max-width: 760px; padding-top: clamp(32px, 6vw, 64px); }
  .back {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--mono); font-size: 12px; color: var(--muted);
  }
  .back :global(svg) { transform: rotate(180deg); }
  .back:hover { color: var(--accent); }
  h1 {
    margin: 18px 0 0;
    font-size: clamp(1.9rem, 4.2vw, 2.6rem); font-weight: 600;
    line-height: 1.18; letter-spacing: -0.02em; text-wrap: balance;
  }
  .meta {
    margin: 14px 0 0; display: flex; flex-wrap: wrap; gap: 10px;
    font-family: var(--mono); font-size: 12px; color: var(--muted);
  }
  .meta .sep { opacity: 0.5; }

  .post-foot {
    display: flex; gap: 10px; margin-top: 56px;
    padding-top: 24px; border-top: 1px solid var(--line);
  }

  /* the article body */
  .prose { margin-top: 40px; font-size: 1.05rem; line-height: 1.72; color: var(--ink-2); }
  .prose :global(> * + *) { margin-top: 1.15em; }
  .prose :global(h2) {
    margin-top: 2.2em; font-size: 1.4rem; font-weight: 600; color: var(--ink);
    letter-spacing: -0.014em; line-height: 1.3;
  }
  .prose :global(h3) {
    margin-top: 1.8em; font-size: 1.12rem; font-weight: 600; color: var(--ink);
  }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .prose :global(a) {
    color: var(--accent); text-decoration: underline;
    text-underline-offset: 3px; text-decoration-thickness: 1px;
  }
  .prose :global(a:hover) { text-decoration-thickness: 2px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3em; }
  .prose :global(li + li) { margin-top: 0.4em; }
  .prose :global(li::marker) { color: var(--muted); }
  .prose :global(blockquote) {
    margin-inline: 0; padding: 2px 0 2px 20px;
    border-left: 3px solid var(--accent); color: var(--ink-2);
  }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 2.4em 0; }
  .prose :global(img) { border-radius: 10px; border: 1px solid var(--line); }
  .prose :global(figcaption) {
    font-family: var(--mono); font-size: 12px; color: var(--muted); margin-top: 8px;
  }
  .prose :global(table) {
    width: 100%; border-collapse: collapse; font-size: 0.95rem;
    display: block; overflow-x: auto;
  }
  .prose :global(th), .prose :global(td) {
    text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--line);
  }
  .prose :global(th) { color: var(--ink); font-weight: 600; }

  /* inline code and Shiki blocks */
  .prose :global(code) {
    font-family: var(--mono); font-size: 0.88em;
    background: var(--surface-2); border: 1px solid var(--line);
    border-radius: 5px; padding: 0.08em 0.32em;
  }
  .prose :global(pre) {
    padding: 16px 18px; border-radius: 11px; overflow-x: auto;
    border: 1px solid var(--line); font-size: 13px; line-height: 1.65;
  }
  .prose :global(pre code) {
    background: none; border: 0; padding: 0; font-size: inherit;
  }
  /* Shiki ships both themes. Take its token colours, but keep the block's
     background on the page's own surface - github-dark's blue-grey fights the
     warm paper this site is built on. */
  .prose :global(.astro-code) { background-color: var(--surface) !important; }
  :global(:root[data-theme="dark"]) .prose :global(.astro-code span) {
    color: var(--shiki-dark) !important;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .prose :global(.astro-code span) {
      color: var(--shiki-dark) !important;
    }
  }
</style>
