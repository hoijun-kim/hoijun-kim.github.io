---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---

<Base
  title="Not here - Hoijun Kim"
  description="That page does not exist on this site."
  noindex
>
  <section class="wrap miss">
    <p class="label">404</p>
    <h1>That page is not here.</h1>
    <p class="lede">
      Either it never was, or it moved and I did not leave a note. The two places worth
      trying are below.
    </p>
    <div class="actions">
      <a class="btn" href="/">The work <Icon name="arrow" size={14} /></a>
      <a class="btn" href="/blog/">The writing <Icon name="arrow" size={14} /></a>
    </div>
  </section>
</Base>

<style>
  .miss { padding-top: clamp(64px, 14vw, 150px); padding-bottom: 60px; }
  h1 {
    margin: 14px 0 0; max-width: 16ch;
    font-size: clamp(1.9rem, 4.4vw, 2.8rem); font-weight: 600;
    line-height: 1.16; letter-spacing: -0.02em;
  }
  .lede { margin: 20px 0 0; max-width: 48ch; color: var(--ink-2); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
</style>
