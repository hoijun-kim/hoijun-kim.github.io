---
import Mark from "./Mark.astro";
import Icon from "./Icon.astro";
const path = Astro.url.pathname;
const onBlog = path.startsWith("/blog");
---

<header class="bar">
  <div class="wrap bar-in">
    <a class="mark" href="/" aria-label="Hoijun Kim - home"><Mark size={25} /></a>
    <nav class="nav" aria-label="Sections">
      <a href="/" class:list={[{ here: !onBlog }]} aria-current={!onBlog ? "page" : undefined}>work</a>
      <a href="/blog" class:list={[{ here: onBlog }]} aria-current={onBlog ? "page" : undefined}>writing</a>
    </nav>
    <div class="bar-links">
      <a class="icon-btn" href="https://github.com/hoijun-kim" aria-label="GitHub" rel="me"><Icon name="github" /></a>
      <a class="icon-btn" href="mailto:hoijun.kim00@gmail.com" aria-label="Email"><Icon name="mail" /></a>
      <button class="icon-btn" id="theme" type="button" aria-label="Switch to dark theme"><Icon name="theme" /></button>
    </div>
  </div>
</header>

<style>
  .bar { padding-top: 22px; }
  .bar-in { display: flex; align-items: center; gap: 20px; }
  .mark { display: inline-flex; color: var(--ink); }

  .nav { display: flex; gap: 4px; font-family: var(--mono); font-size: 12.5px; }
  .nav a {
    position: relative; padding: 5px 9px; border-radius: 7px; color: var(--muted);
    transition: color .15s, background .15s;
  }
  .nav a:hover { color: var(--ink); background: var(--surface-2); }
  .nav a.here { color: var(--ink); }
  .nav a.here::after {
    content: ""; position: absolute; left: 9px; right: 9px; bottom: 1px;
    height: 2px; border-radius: 2px; background: var(--accent);
  }

  .bar-links { margin-left: auto; display: flex; align-items: center; gap: 2px; }
  .icon-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 8px; color: var(--muted);
    border: 1px solid transparent; background: transparent; cursor: pointer;
    transition: color .15s, background .15s;
  }
  .icon-btn:hover { color: var(--ink); background: var(--surface-2); }

  @media (max-width: 460px) {
    .bar-in { gap: 10px; }
    .nav a { padding: 5px 6px; }
  }
</style>
