---
/**
 * giscus, which is GitHub Discussions in an iframe. That iframe is heavier
 * than everything else on the page put together, so it is not requested until
 * the reader scrolls near it - the article is never held up by a comment
 * thread nobody has looked at yet.
 */
import { comments, commentsOn } from "../config";
---

{/* inline rather than a scoped <style>: Astro bundles a scoped block whether
    or not the markup renders, and this file is usually switched off */}
{commentsOn && (
  <section class="comments" lang="en" aria-label="Comments">
    <h2 class="label">Comments</h2>
    <div
      id="giscus"
      data-repo={comments.repo}
      data-repo-id={comments.repoId}
      data-category={comments.category}
      data-category-id={comments.categoryId}
    >
      <noscript>
        <p class="fallback">
          Comments run on GitHub Discussions and need JavaScript.
          <a href={`https://github.com/${comments.repo}/discussions`}>Open the thread on GitHub</a>.
        </p>
      </noscript>
    </div>
    <style is:inline>
      .comments { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--line); }
      .comments h2 { margin: 0 0 18px; font-size: 11.5px; }
      #giscus { min-height: 148px; }
      .fallback { font-size: 0.95rem; color: var(--ink-2); }
      .fallback a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
    </style>
  </section>
)}

{commentsOn && (
  <script>
    const mount = document.getElementById("giscus");

    const scheme = () => {
      const set = document.documentElement.getAttribute("data-theme");
      if (set) return set;
      return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    };
    const giscusTheme = () => (scheme() === "dark" ? "transparent_dark" : "light");

    function load() {
      if (!mount || mount.dataset.loaded) return;
      mount.dataset.loaded = "1";
      const s = document.createElement("script");
      s.src = "https://giscus.app/client.js";
      s.async = true;
      s.crossOrigin = "anonymous";
      Object.entries({
        repo: mount.dataset.repo!,
        repoId: mount.dataset.repoId!,
        category: mount.dataset.category!,
        categoryId: mount.dataset.categoryId!,
        mapping: "pathname",
        strict: "1",
        reactionsEnabled: "1",
        emitMetadata: "0",
        inputPosition: "top",
        theme: giscusTheme(),
        lang: document.documentElement.lang === "ko" ? "ko" : "en",
        loading: "lazy",
      }).forEach(([k, v]) => s.setAttribute(`data-${k.replace(/[A-Z]/g, (c) => "-" + c.toLowerCase())}`, v));
      mount.appendChild(s);
    }

    if (mount) {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && (load(), io.disconnect())),
        { rootMargin: "600px" },
      );
      io.observe(mount);
    }

    // the iframe cannot read our stylesheet, so hand it the theme on every change
    const tell = () => {
      const frame = document.querySelector<HTMLIFrameElement>("iframe.giscus-frame");
      frame?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: giscusTheme() } } },
        "https://giscus.app",
      );
    };
    document.getElementById("theme")?.addEventListener("click", () => setTimeout(tell, 0));
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", tell);
  </script>
)}
